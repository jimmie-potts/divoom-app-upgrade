# Private settings for the Pixoo user service. Copy to
# ~/.config/pixoo-playlist-controller/service.env with mode 0600.
# Values are literal: no quotes, $HOME or ~ expansion.
PIXOO_DATA_DIR=/home/<user>/.local/share/pixoo-playlist-controller
PIXOO_PORT=8787
PIXOO_MODE=device
PIXOO_MONITOR_ENABLED=1
PIXOO_CONTROLLER_ENABLED=1
# Keep these identical to the identity the hub already registered.
PIXOO_CONTROLLER_DEVICE_ID=pixoo-local
PIXOO_CONTROLLER_ID=pixoo-controller
PIXOO_CONTROLLER_SOURCE_ID=pixoo
